diff --git a/assets/web/js/main.js b/assets/web/js/main.js
index a07dad5..601343f 100644
--- a/assets/web/js/main.js
+++ b/assets/web/js/main.js
@@ -301,6 +301,13 @@ function isRevokedKey(error) {
   return servedByHomey && error.status === 401;
 }
 
+// Behind the Docker proxy a 401 means this browser's session ran out: sign in again.
+function signInAgain(error) {
+  if (state.config?.proxy !== true || error?.status !== 401) return false;
+  location.assign('/login');
+  return true;
+}
+
 function pairAgain() {
   writeStoredConfig({});
   state.config = { ...state.config, token: undefined };
@@ -361,6 +368,7 @@ async function boot() {
     settleKioskHome();
     $('edit-button').hidden = false;
   } catch (error) {
+    if (signInAgain(error)) return;
     if (isRevokedKey(error)) return pairAgain();
     setStatus('error', 'Not connected');
     openSetup(`Could not reach Homey: ${error.message}`);
