# Kopieer dit bestand naar .env en vul het in.

# Adres van je Homey (Pro of Self-Hosted Server), zoals je het lokaal bereikt.
#   Homey Pro:  https://192-168-1-50.homey.homeylocal.com   (je IP met streepjes)
#   of gewoon:  http://192.168.1.50
#   SHS:        http://<ip-van-de-pc>:<poort van je SHS>
HOMEY_URL=https://192-168-1-50.homey.homeylocal.com

# API-sleutel van je Homey. Blijft op de server; geen enkele browser krijgt hem te zien.
HOMEY_TOKEN=

# Wachtwoord voor het dashboard. Leeg = iedereen op je netwerk kan het openen en bedienen.
DASHBOARD_PASSWORD=

# Taal van de knoppen en menu's: leeg = de taal van je Homey; "en" = Engels, "nl" = Nederlands.
DASHBOARD_LANGUAGE=

# Hoe lang een browser aangemeld blijft (dagen). Handig voor wandtablets.
SESSION_DAYS=365

# Sleutel voor de flow-aanroepen (/flow/...). Leeg = er wordt er een gemaakt in ./data/flow-key.
FLOW_KEY=

# Zet op true als je er later een reverse proxy (Nginx Proxy Manager, Traefik, Caddy) voor zet.
TRUST_PROXY=false

# Alleen als je Homey een eigen (zelfondertekend) certificaat gebruikt.
HOMEY_INSECURE_TLS=false
